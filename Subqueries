/* First Practice Subqueries on select clause*/
Select
    p.Name,
    --Subquery created
  (Select Sum(OrderQty)
      From 
          Sales.SalesOrderDetail sod
      Where 
          p.ProductID = sod.ProductID) As TotalSold --Subquery finished 
    -- Comparing the product ID between both tables and showing as Total sold
      From Production.Product p;

/*Second Practice Subqueries on where clause*/
Select
    Name, 
    ListPrice
  From 
        Production.Product
    Where 
        ListPrice > (SELECT AVG(ListPrice) FROM Production.Product);
/*Inside the where conditional we create a subquerie to call the average price 
from products and showing only the top products from it, resulting in the expensive ones*/

/*Third practice subqueries on from clause*/
Select
    p.Name,
    totals.TotalSold
From 
    Production.Product p
Join 
    (Select ProductID, Sum(OrderQty) As TotalSold
     --Subquery created
     From 
        Sales.SalesOrderDetail 
        Group By ProductID) As totals
     --Finished 
On 
    p.ProductID = totals.ProductID;
